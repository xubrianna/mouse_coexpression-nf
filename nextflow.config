/*
 * Nextflow configuration for mouse coexpression pipeline
 */

params {
    // Input/Output - expects filtered h5ad files (CellType_StudyName.h5ad)
    input_dir = null
    outdir = "${launchDir}/results_${new Date().format('yyyyMMdd_HHmmss')}"
    
    // Step 1: Gene list generation parameters
    gene_frequency_threshold = 0.2  // Genes found in >=20% of studies (less stringent)
    
    // Step 2: Gene selection strategy
    gene_selection_strategy = 'intersection'  // Options: 'intersection', 'union', or specific cell type like 'Mic'
    
    // Step 3: Coexpression parameters
    correlation_type = 'pearson'
    replace_nans = true
    min_cells = null
    
    // Conda environment
    conda_env = "/home/bxu/miniconda3/envs/python"
}

// Process resources
process {
    // Use symlinks for staging files (prevents corruption, saves space)
    stageInMode = 'symlink'
    
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Always use SLURM for coexpression computation
    withName: 'COMPUTE_COEXPRESSION' {
        executor = 'slurm'
        // Remove queue specification to use default partition
        // clusterOptions = '--account=def-account'  // Uncomment and update if needed
    }
}

// Conda configuration
conda {
    enabled = true
    useMamba = false
}

// Cleanup configuration
cleanup = true  // Auto-remove work files on successful completion

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    slurm {
        executor {
            queueSize = 100
            submitRateLimit = '10 sec'
        }
    }
}

// Report configuration
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

manifest {
    name = 'mouse_coexpression-nf'
    author = 'Brianna Xu'
    description = 'Compute gene-gene coexpression matrices from mouse single-cell RNA-seq data'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
