/*
 * Nextflow configuration for mouse coexpression pipeline
 */

params {
	// Input/Output - expects filtered h5ad files (CellType_StudyName.h5ad)
	input_dir = null
	outdir = "${launchDir}/results_${new Date().format('yyyyMMdd_HHmmss')}"

	// Step 1: Gene list generation parameters
	gene_frequency_threshold = 0.2 // Genes found in >=20% of studies (less stringent)

	// Step 2: Gene selection strategy
	gene_selection_strategy = 'intersection' // Options: 'intersection', 'union', or specific cell type like 'Mic'

	// Step 3: Coexpression parameters
	correlation_type = 'pearson'
	replace_nans = true
	min_cells = null

	// Workaround for current Slurm setup:
	// ask for >100G RAM so jobs land on newer 512G nodes
	// ask for 8 CPUs/task to reduce jobs per node

	compute_cpus = 8
	compute_memory = '120 GB'

	// Conda environment
	conda_env = "/home/bxu/miniconda3/envs/python"
}

// Process resources
process {
	// Use symlinks for staging files by default to save space
	stageInMode = 'symlink'

	errorStrategy = 'retry'
	maxRetries = 2

	// This step rewrites h5ad files, so stage as copies for extra safety.
	withName: 'SELECT_GENES_AND_CPM' {
		executor = 'slurm'
		cpus = 2
		memory = '12 GB'
		time = '1h'
		stageInMode = 'copy'
	}

	// Always use SLURM for coexpression computation
	withName: 'COMPUTE_COEXPRESSION' {
		executor = 'slurm'
        cpus = params.compute_cpus
        memory = params.compute_memory
		
	}
}

// Conda configuration
conda {
	enabled = true
	useMamba = false
}

// Cleanup configuration
cleanup = true // Auto-remove work files on successful completion

// Execution profiles
profiles {
	standard {
		process.executor = 'local'
	}

	slurm {
		process.executor = 'slurm'
		executor {
			perCpuMemAllocation = false
			submitRateLimit = '5 sec'
		}
	}
}

// Report configuration
timeline {
	enabled = true
	file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
	enabled = true
	file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
	enabled = true
	overwrite = true
	file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
	enabled = true
	file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

manifest {
	name = 'mouse_coexpression-nf'
	author = 'Brianna Xu'
	description = 'Compute gene-gene coexpression matrices from mouse single-cell RNA-seq data'
	version = '1.0.0'
	nextflowVersion = '>=23.04.0'
}
